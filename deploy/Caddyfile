# Caddy mengurus sertifikat HTTPS sendiri untuk domain ini dan meneruskan semuanya,
# termasuk WebSocket /ws, ke app.
{$DOMAIN} {
	encode zstd gzip

	# Nama file di /assets mengandung hash isi (hasil Vite): aman di-cache selamanya.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:8080
}
