BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,server=debug

# Wajib. Daftar gratis di https://finnhub.io/register
FINNHUB_API_KEY=

# Postgres dari docker-compose.yml (kredensial khusus dev lokal).
DATABASE_URL=postgres://usstock:usstock@127.0.0.1:5433/usstock

# Opsional. Secret dari dashboard webhook Finnhub; dikirim di header X-Finnhub-Secret.
# Kosong = endpoint POST /webhook/finnhub dimatikan (404).
FINNHUB_WEBHOOK_SECRET=
