# Domain yang A record-nya sudah mengarah ke IP VPS. Caddy meminta sertifikat untuknya.
DOMAIN=tickstream.example.com

# Port app di 127.0.0.1, tujuan proxy_pass kalau memakai nginx.
APP_PORT=8080

# Tag image dari GHCR. Rollback: isi sha-<commit>, lalu pull + up -d.
TAG=latest

# Wajib. https://finnhub.io/register
FINNHUB_API_KEY=

# Password database. Pakai hex supaya aman ditaruh di URL koneksi:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Token pemilik (min. 32 karakter): openssl rand -hex 32
# Kosong = watchlist cuma bisa dibaca.
ADMIN_TOKEN=

# Opsional. Kosong = webhook Finnhub dimatikan.
FINNHUB_WEBHOOK_SECRET=
